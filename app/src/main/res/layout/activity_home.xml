<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".MainActivity">



        <!-- Bottom Bar  -->

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/frame_layout"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:menu="@menu/bottom_menu"
        app:backgroundTint="@color/md_theme_primaryContainer"
        app:itemIconTint="@color/md_theme_onPrimaryContainer"
        app:itemTextColor="@color/md_theme_onPrimaryContainer"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.BottomAppBar.Rounded"
        app:itemIconSize="25dp"
        app:labelVisibilityMode="labeled"
        app:layout_behavior="@string/hide_bottom_view_on_scroll_behavior"
        style="@style/BottomNavStyle" />
    <!-- FAB -->

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="50dp"
        android:src="@drawable/ic_mic"
        app:maxImageSize="27dp"
        app:tint="@color/md_theme_onPrimaryContainer"
        app:backgroundTint="@color/md_theme_primaryContainer"
        app:fabCustomSize="65dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.FloatingActionButton"
        />

</androidx.coordinatorlayout.widget.CoordinatorLayout>





